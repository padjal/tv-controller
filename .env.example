# Copy to .env — read by docker compose, not by the server directly.
# For running the server outside Docker, see server/.env.example instead.

# Required. The address Pi agents use to reach this server. Must be an IP or
# hostname the Pis can actually resolve — not localhost.
SERVER_BASE_URL=http://192.168.1.10:8000

# Optional. The host port to publish on; the container always listens on 8000.
PORT=8000

# Optional. Try `info,server=debug` when diagnosing playback or the heartbeat.
RUST_LOG=info
