# Copy to server/.env and adjust. Loaded by dotenvy at startup.

# Required. The address Pi agents use to reach this server — it is embedded in
# the video URLs sent to them, so "localhost" only works if the agent runs on
# this same machine.
SERVER_BASE_URL=http://192.168.1.10:8000

# Optional. Defaults shown.
DATABASE_URL=sqlite:tv-controller.db
VIDEOS_DIR=videos

# Where generated poster frames are written. Kept out of VIDEOS_DIR on purpose:
# ServeDir hands out everything in that directory, and the scanner would then
# have to skip its own output. Defaults under data/ so it shares the database's
# volume and survives a container restart.
THUMBNAILS_DIR=data/thumbnails
PORT=8000
# Built dashboard (npm run build). Relative paths resolve against the working
# directory. If it is missing, the API still works and / returns 404.
DASHBOARD_DIR=dashboard/dist
